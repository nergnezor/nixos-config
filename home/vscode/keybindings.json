// VS Codes debugstart engagerar sig inte i angelbeach-godot -- startDebugging
// kommer aldrig ens till activateByEvent('onDebug'), varken via F5 eller via
// kommandopaletten. Tasks fungerar däremot. Så länge det är oläst binder vi
// F5 till task-vägen, men bara i det projektet: when-villkoret matchar på
// sökvägen, så F5 är oförändrad debugstart i blade, rc3d, stm32 och allt annat.
[
  {
    "key": "f5",
    "command": "workbench.action.tasks.runTask",
    "args": "play (windowed, no debugger)",
    "when": "resourcePath =~ /angelbeach-godot/ && !inDebugMode"
},
{
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
        "text": "\u001b\r"
    },
    "when": "terminalFocus"
}
]