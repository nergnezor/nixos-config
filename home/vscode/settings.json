			"approve": true,
			"matchCommandLine": true
		},
		"node dump-and-zstd.mjs worker-keys.ndjson kv-zst 2 7e5b5c1090474b0388e12b3fe8676286": {
			"approve": true,
			"matchCommandLine": true
		},
		"npm run build": true,
