layout {

    focus-ring {
        active-color   "#b48ead"
        inactive-color "#2e3440"
        urgent-color   "#bf616a"
    }

    border {
        active-color   "#b48ead"
        inactive-color "#2e3440"
        urgent-color   "#bf616a"
    }


    tab-indicator {
        active-color   "#b48ead"
        inactive-color "#5f3156"
        urgent-color   "#bf616a"
    }

    insert-hint {
        color "#b48ead80"
    }
}

recent-windows {
    highlight {
        active-color "#b48ead"
        urgent-color "#bf616a"
    }
}
