// Uxstream
output "DP-3" {
    mode "3840x2160@59.997"
    scale 1.2
    //position x=0 y=0
    position x=3840 y=0
    focus-at-startup
    layout {
        always-center-single-column
    }
}
output "DP-4" {
    mode "1920x1080@59.997"
    scale 1.15
    transform "90"
}

// Home
output "DP-2" {
    mode "3840x2160@59.997"
    scale 1.25
    position x=205 y=1728
    focus-at-startup
    layout {
        always-center-single-column
    }
}

output "DP-1" {
    mode "2560x1440@69.923"
    scale 1.25
    transform "270"
    position x=3277 y=1408
    focus-at-startup
}

output "HDMI-A-1" {
    mode "3840x2160@60.000"
    scale 1.25
    position x=0 y=0
    variable-refresh-rate
}

